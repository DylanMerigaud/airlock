# Copy to .env.local at the repo root and load it with: set -a; source .env.local; set +a
# Never put a .env inside an agent folder: `adk deploy agent_engine` reads it and overrides the
# Secret Manager references of .agent_engine_config.json with its plain values (measured 2026-08-28).
GOOGLE_CLOUD_PROJECT=airlock-agentic-cinema
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1

# Grafana stack (non-secret)
GRAFANA_URL=https://<stack>.grafana.net
GRAFANA_INFLUX_URL=https://influx-prod-XX-prod-<region>.grafana.net/api/v1/push/influx/write
GRAFANA_INFLUX_USER=<metrics instance id>

# Secrets: keychain locally (see infra/gcp/secrets.sh), Secret Manager in the cloud
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_INFLUX_TOKEN=
AIRLOCK_MCP_TOKEN=

# The mcp-grafana server the agents talk to
AIRLOCK_MCP_URL=https://airlock-mcp-grafana-<hash>.us-central1.run.app/mcp
AIRLOCK_DASHBOARD_UID=airlock-gates
AIRLOCK_RUNTIME=local

# The deployed pipeline (agents/pipeline) and the public dashboard, for the console and the scripts
AGENT_ENGINE_RESOURCE=projects/771466810465/locations/us-central1/reasoningEngines/1737023312967499776
AIRLOCK_PUBLIC_DASHBOARD_URL=https://narrowsubmarine1895.grafana.net/public-dashboards/97860661238c4536a743e0d858aef845
GRAFANA_PROM_UID=grafanacloud-prom
GRAFANA_LOKI_UID=grafanacloud-logs
