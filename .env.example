# Copy to agents/<agent>/.env for `adk run`, and export for the scripts. Never commit a filled copy.
GOOGLE_CLOUD_PROJECT=airlock-agentic-cinema
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1

# Grafana stack (non-secret)
GRAFANA_URL=https://<stack>.grafana.net
GRAFANA_INFLUX_URL=https://influx-prod-XX-prod-<region>.grafana.net/api/v1/push/influx/write
GRAFANA_INFLUX_USER=<metrics instance id>

# Secrets: keychain locally (see infra/gcp/secrets.sh), Secret Manager in the cloud
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_INFLUX_TOKEN=
AIRLOCK_MCP_TOKEN=

# The mcp-grafana server the agents talk to
AIRLOCK_MCP_URL=https://airlock-mcp-grafana-<hash>.us-central1.run.app/mcp
AIRLOCK_DASHBOARD_UID=airlock-gates
AIRLOCK_RUNTIME=local
