{
  "source": "airlock/verdict.py promql_questions(gate), exported by scripts/export_promql.py; do not edit by hand",
  "keys": [
    "error_rate_15m",
    "runs_15m",
    "seconds_since_success",
    "calibration_catches_7d",
    "last_calibration_caught"
  ],
  "health_only_keys": [],
  "stale_after_s": 900,
  "error_ratio_block": 0.5,
  "error_runs_min": 2,
  "gates": {
    "rights": {
      "error_rate_15m": "sum(sum_over_time(airlock_gate_errors_total{gate=\"rights\"}[15m])) / clamp_min(sum(sum_over_time(airlock_gate_runs_total{gate=\"rights\"}[15m])), 1)",
      "runs_15m": "sum(sum_over_time(airlock_gate_runs_total{gate=\"rights\"}[15m]))",
      "seconds_since_success": "time() - max(max_over_time(airlock_gate_last_success_ts{gate=\"rights\"}[7d]))",
      "calibration_catches_7d": "sum(sum_over_time(airlock_calibration_catches_total{gate=\"rights\"}[7d]))",
      "last_calibration_caught": "min by () (last_over_time(airlock_calibration_catches_total{gate=\"rights\"}[7d]))"
    },
